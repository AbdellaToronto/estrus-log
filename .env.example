# =============================================================================
# Estrus Log - Environment Variables
# =============================================================================
# Copy this file to .env.local and fill in your values

# -----------------------------------------------------------------------------
# Supabase
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# -----------------------------------------------------------------------------
# Clerk Authentication
# -----------------------------------------------------------------------------
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# -----------------------------------------------------------------------------
# Google Cloud Storage (for image uploads)
# -----------------------------------------------------------------------------
GCS_BUCKET_NAME=your-bucket-name
GCP_PROJECT_ID=your-project-id
# Use ONE of these three options for credentials:
# Option 1: JSON string
GCP_SERVICE_ACCOUNT_KEY={"type":"service_account",...}
# Option 2: Base64 encoded JSON
# GCP_SERVICE_ACCOUNT_KEY_B64=base64-encoded-json
# Option 3: Path to file (local dev only)
# GCP_SERVICE_ACCOUNT_KEY_FILE=/path/to/service-account.json

# Optional: CDN URL for serving images
# GCS_CDN_BASE_URL=https://cdn.yourdomain.com

# -----------------------------------------------------------------------------
# Trigger.dev (background jobs)
# -----------------------------------------------------------------------------
TRIGGER_SECRET_KEY=tr_dev_...

# -----------------------------------------------------------------------------
# AI Services (Modal endpoints)
# -----------------------------------------------------------------------------
# BioCLIP embedding endpoint
BIOCLIP_API_URL=https://abdellaalioncan--estrus-pipeline-embed-endpoint.modal.run

# SAM3 segmentation endpoint  
SAM3_API_URL=https://abdellaalioncan--estrus-pipeline-segment-endpoint.modal.run

# Optional single-image visual suggestion route (/api/classify)
GOOGLE_GENERATIVE_AI_API_KEY=your-google-ai-api-key
# Leave unset to use the app default. Change only after a documented evaluation.
# GOOGLE_GENERATIVE_AI_MODEL=gemini-3-pro

# Optional local S-BIAD2395 binary research ensemble. This model returns only
# PROESTRUS_OR_ESTRUS versus METESTRUS_OR_DIESTRUS and always requires review.
# Start it with: uvicorn public_binary_api:app --app-dir python-service --port 8001
# ESTRUS_BINARY_MODEL_API_URL=http://127.0.0.1:8001
# ESTRUS_BINARY_API_TOKEN=generate-a-local-secret
# ESTRUS_BINARY_MODEL_DIR=work/model-eval/public-confirmatory-20260719
# ESTRUS_BINARY_BENCHMARK_DIR=work/model-eval/public-foundation-benchmark-20260719
# ESTRUS_BINARY_PUBLIC_DATA_DIR=work/model-eval/public/S-BIAD2395/estrus images
# ESTRUS_BINARY_DEVICE=auto

# Safety gate: predictions are review-only by default. Set to true only after
# validating the configured model/reference library for this colony and imaging protocol.
# CLASSIFIER_AUTO_ACCEPT=true

# -----------------------------------------------------------------------------
# Webhooks
# -----------------------------------------------------------------------------
WEBHOOK_SECRET=your-webhook-secret
