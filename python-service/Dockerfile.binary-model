# Cloud Run container for the promoted external-photo binary model.
#
# Cloud Run rather than Vercel because torch cannot fit in a Vercel Function
# bundle, and Cloud Run rather than Modal because this project already has GCP
# credentials and Cloud Run services in place.
#
# CPU-only torch deliberately. The heads are eight sklearn classifiers over
# frozen DINOv2-small and DINOv2-base features; on one photograph that is a few
# seconds on CPU, which avoids Cloud Run's GPU quota entirely and keeps the image
# near 1 GB instead of 4 GB.
#
# Build and deploy with scripts/deploy-binary-model.sh

FROM python:3.12-slim

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    HF_HOME=/opt/hf \
    TRANSFORMERS_VERBOSITY=error \
    OMP_NUM_THREADS=4

WORKDIR /app

RUN apt-get update \
 && apt-get install -y --no-install-recommends libgomp1 curl \
 && rm -rf /var/lib/apt/lists/*

# CPU wheels only — the default index pulls multi-gigabyte CUDA packages.
RUN pip install --no-cache-dir \
      --index-url https://download.pytorch.org/whl/cpu \
      torch==2.8.0 torchvision==0.23.0 \
 && pip install --no-cache-dir \
      "transformers==4.57.1" \
      `# Must match the version that fitted the heads. They were pickled by` \
      `# 1.9.0, which no longer stores LogisticRegression.multi_class; loading` \
      `# them under 1.7.x crashes because that code still reads the attribute.` \
      "scikit-learn==1.9.0" \
      "joblib==1.5.2" \
      "numpy==2.3.4" \
      "pillow==11.3.0" \
      "fastapi==0.121.1" \
      "uvicorn[standard]==0.38.0" \
      "python-multipart==0.0.20"

COPY python-service/public_binary_inference.py \
     python-service/public_binary_api.py \
     python-service/benchmark_public_external_binary.py \
     /app/python-service/
COPY python-service/model-policies /app/python-service/model-policies

# Artifacts arrive in the build context via the deploy script, which pulls them
# from object storage first. Baking them in keeps cold starts to model load only.
COPY artifacts/public-confirmatory-20260719 /app/work/model-eval/public-confirmatory-20260719
COPY artifacts/public-foundation-benchmark-20260719 /app/work/model-eval/public-foundation-benchmark-20260719
# JSON-array form is required: the upstream dataset directory name contains a
# space, and shell-form COPY splits the destination on it.
COPY ["artifacts/public-data", "/app/work/model-eval/public/S-BIAD2395/estrus images/"]

# Pre-download the backbones at the revisions pinned in the policy so a cold
# start does not also wait on Hugging Face.
RUN python -c "\
from transformers import AutoImageProcessor, AutoModel; \
[(AutoImageProcessor.from_pretrained(n, revision=r), AutoModel.from_pretrained(n, revision=r)) \
 for n, r in [('facebook/dinov2-small','ed25f3a31f01632728cabb09d1542f84ab7b0056'), \
              ('facebook/dinov2-base','f9e44c814b77203eaa57a6bdbbd535f21ede1415')]]"

ENV ESTRUS_BINARY_MODEL_DIR=/app/work/model-eval/public-confirmatory-20260719 \
    ESTRUS_BINARY_BENCHMARK_DIR=/app/work/model-eval/public-foundation-benchmark-20260719 \
    ESTRUS_BINARY_PUBLIC_DATA_DIR="/app/work/model-eval/public/S-BIAD2395/estrus images" \
    ESTRUS_BINARY_POLICY_PATH=/app/python-service/model-policies/s-biad2395-dinov2-robust-ensemble-v2.json \
    ESTRUS_BINARY_DEVICE=cpu \
    PYTHONPATH=/app/python-service

# Cloud Run supplies PORT. One worker: the model is loaded once per container and
# concurrency is bounded by the service configuration instead.
CMD exec uvicorn public_binary_api:app --app-dir /app/python-service --host 0.0.0.0 --port ${PORT:-8080} --workers 1
